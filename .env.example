# ==========================================================
#  AgriGPT configuration
#  1. Copy this file to  .env
#  2. Paste your FREE Groq API key (https://console.groq.com/keys)
# ==========================================================

GROQ_API_KEY=paste-your-groq-key-here

# Any long random string — used to sign login tokens
SECRET_KEY=agrigpt-change-this-to-a-long-random-string

# LLM on Groq (free + very fast).
# NOTE: Groq shut down the Llama 3.1/3.3 models on 16-Aug-2026.
#   qwen/qwen3.6-27b   -> DEFAULT: free, 131K context, strong Indian-language support
#   openai/gpt-oss-20b -> fallback if the above is rate-limited
LLM_MODEL=qwen/qwen3.6-27b

# Embedding model for RAG (turns text into numbers).
#   Default = small & fast (470 MB) — best for the 5-hour demo.
#   Final submission: sentence-transformers/BAAI/bge-m3 (2.3 GB, best multilingual)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
